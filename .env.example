# GitPulse configuration (revised: MongoDB-based). Copy to .env and edit.

# GitHub
GITHUB_TOKEN=                    # optional for local-repo analysis; needed for private/remote API
GITHUB_WEBHOOK_SECRET=           # used by the PR Review webhook (v0.3)

# LLM provider (v0.2) — pick ONE backend; all LLM features are optional.
LLM_PROVIDER=local                       # local | openai | claude | gemini
LLM_MODEL=                               # blank = per-provider default
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# local (LM Studio or any OpenAI-compatible server):
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# bring-your-own-key (only the one matching LLM_PROVIDER is needed):
ANTHROPIC_API_KEY=                       # for LLM_PROVIDER=claude  (default model claude-opus-4-8)
OPENAI_API_KEY=                          # for LLM_PROVIDER=openai
GEMINI_API_KEY=                          # for LLM_PROVIDER=gemini

# Storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gitpulse
CHROMA_PATH=data/chroma
GITPULSE_CACHE_DIR=data/cache    # JSON fallback cache when MongoDB is unavailable
GITPULSE_STORE=auto              # auto | mongo | json

# Analysis tuning
BUG_KEYWORDS=fix,bug,resolve,patch,hotfix,closes
HOTSPOT_LOOKBACK_DAYS=90
CHURN_WINDOW_DAYS=30
HOTSPOT_RECENCY_HALFLIFE_DAYS=30   # decay half-life for the recency-weighted bug score

# XGBoost "second opinion" (optional ML model)
ML_MODEL_PATH=data/models/hotspot_xgb.json
ML_LABEL_WINDOW_DAYS=90            # label = bug fix within this window after a cutoff
ML_SNAPSHOTS=4                     # temporal cutoffs per repo
ML_MIN_POSITIVES=20               # below this, the model is flagged "unreliable"
